{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VTools component request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "component",
        "config",
        "run_dir"
      ],
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "component": {
          "const": "model_compression"
        },
        "config": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "run_dir": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weights": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "data": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "train": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "val": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "teacher_weights": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "student_weights": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "structured_initial_weights": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "task": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "structured_scale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "structured_method": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "structured_methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "structured_epochs": {
              "type": "integer",
              "minimum": 0
            },
            "only": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "enable": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "disable": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["structured_methods"]
              },
              "then": {
                "not": {"required": ["structured_method"]},
                "properties": {
                  "task": {"const": "detect"},
                  "only": {
                    "contains": {"const": "compression.prune.structured"},
                    "items": {"enum": ["compression.prune.structured", "model.parameters", "baseline.evaluate"]}
                  },
                  "enable": {"maxItems": 0},
                  "disable": {"maxItems": 0}
                }
              }
            },
            {
              "if": {
                "required": [
                  "only"
                ]
              },
              "then": {
                "properties": {
                  "enable": {
                    "maxItems": 0
                  },
                  "disable": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    }
  ]
}
